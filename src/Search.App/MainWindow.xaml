<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Search.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Search.Core"
    xmlns:local="using:Search.App"
    Title="Search">
    <!-- A row of tabs, down the left or across the top, one field, and the page. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColumnDef" Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The title bar: empty, draggable. In strip mode the tabs sit in it, left of the drag space. -->
        <Grid x:Name="TopBar" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="StripDef" Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
            </Grid.ColumnDefinitions>
            <ListView x:Name="Strip" Grid.Column="0" Visibility="Collapsed" SelectionMode="Single" Height="36" Margin="8,2,0,2"
                      CanReorderItems="True" AllowDrop="True" CanDragItems="True" ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollMode="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:Tab">
                        <Grid Width="180" Height="30" ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Image Width="16" Height="16" Source="{x:Bind local:Icons.Of(Icon), Mode=OneWay}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Shown, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Padding="4" Background="Transparent" BorderThickness="0" Click="OnCloseTabClick" Tag="{x:Bind}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Border x:Name="DragSpace" Grid.Column="1" Background="Transparent" />
        </Grid>

        <!-- The column: the field, then the tabs. -->
        <Grid x:Name="Column" Grid.Row="1" Grid.Column="0" Padding="8,0,4,8" RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="ColumnFieldSlot" Grid.Row="0">
                <Grid x:Name="Field" RowSpacing="4">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="SiteButton" Content="&#xE72E;" FontFamily="Segoe Fluent Icons" FontSize="12" Padding="8,6" Background="Transparent" BorderThickness="0"
                                ToolTipService.ToolTip="About this site" Click="OnSiteButton" />
                        <TextBox x:Name="FieldText" Grid.Column="1" PlaceholderText="Search or enter an address" IsSpellCheckEnabled="False" />
                    </Grid>
                    <ListView x:Name="Offers" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single" IsItemClickEnabled="True" MaxHeight="360"
                              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" CornerRadius="8">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:Offer">
                                <Grid ColumnSpacing="10" Padding="0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <!-- The pins: squares wearing the site's icon or a letter, the same in every window. -->
            <GridView x:Name="PinGrid" Grid.Row="1" SelectionMode="Single" Visibility="Collapsed" Padding="0">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="core:Tab">
                        <Grid Width="48" Height="40" CornerRadius="6" ToolTipService.ToolTip="{x:Bind Shown, Mode=OneWay}">
                            <Image Width="18" Height="18" Source="{x:Bind local:Icons.Of(Icon), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Letter, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{x:Bind local:Icons.NoIcon(Icon), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <ListView x:Name="Row" Grid.Row="2" SelectionMode="Single" CanReorderItems="True" AllowDrop="True" CanDragItems="True">
                <ListView.ItemTemplateSelector>
                    <local:RowTemplates>
                        <local:RowTemplates.Tab>
                            <DataTemplate x:DataType="core:Tab">
                                <Grid Height="34" ColumnSpacing="8" Margin="{x:Bind local:Icons.Indent(GroupId), Mode=OneWay}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Image Width="16" Height="16" Source="{x:Bind local:Icons.Of(Icon), Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Shown, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Padding="4" Background="Transparent" BorderThickness="0" Click="OnCloseTabClick" Tag="{x:Bind}" />
                                </Grid>
                            </DataTemplate>
                        </local:RowTemplates.Tab>
                        <local:RowTemplates.Group>
                            <DataTemplate x:DataType="local:GroupRow">
                                <Grid Height="30" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Chevron, Mode=OneWay}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Count, Mode=OneWay}" Opacity="0.6" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </local:RowTemplates.Group>
                    </local:RowTemplates>
                </ListView.ItemTemplateSelector>
            </ListView>
            <StackPanel Grid.Row="3" Spacing="6">
                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="OnNewTabClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                        <TextBlock Text="New Tab" />
                    </StackPanel>
                </Button>
                <!-- The spaces: one button each, the one on screen outlined; right-click for its menu. -->
                <StackPanel x:Name="SpacesBar" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- Folded away (Ctrl+S): a push against the window's left edge slides the column out over the page. -->
        <Border x:Name="Edge" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Left" Background="Transparent" Visibility="Collapsed" Canvas.ZIndex="5" />

        <!-- The page, as a card. -->
        <Border x:Name="Card" Grid.Row="1" Grid.Column="1" Margin="4,0,8,8" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid x:Name="Stage" />
                <!-- Split View's dividers and the outline of the page with the keys, over the pages. -->
                <Canvas x:Name="SplitMarks" />
            </Grid>
        </Border>

        <!-- The field: in the column, or floating over the page when the tabs are across the top. -->
        <Grid x:Name="FieldHost" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Width="640" Margin="0,48,0,0" Visibility="Collapsed" />

        <!-- A panel over the page's right side: history, downloads, bookmarks. Searchable, one key away, Esc puts it away. -->
        <Border x:Name="Panel" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Width="400" Margin="0,0,8,8" Padding="12" CornerRadius="8"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock x:Name="PanelTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <Button HorizontalAlignment="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Click="OnPanelClose" />
                </Grid>
                <TextBox x:Name="PanelSearch" Grid.Row="1" PlaceholderText="Search" />
                <ListView x:Name="PanelRows" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PanelRow">
                            <Grid ColumnSpacing="10" Padding="0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" />
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Visibility="{x:Bind ProgressShown, Mode=OneWay}" IsIndeterminate="{x:Bind Indeterminate, Mode=OneWay}" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{x:Bind ActionGlyph, Mode=OneWay}" FontFamily="Segoe Fluent Icons" FontSize="12" Background="Transparent" BorderThickness="0"
                                        Visibility="{x:Bind ActionShown, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ActionName, Mode=OneWay}" Click="OnPanelRowAction" Tag="{x:Bind}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PanelFoot" Click="OnPanelFoot" Visibility="Collapsed" />
                    <TextBlock x:Name="PanelEmpty" VerticalAlignment="Center" Opacity="0.6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- A question a page asked: the camera, the microphone, where you are, notifications. Over its own page. -->
        <Border x:Name="Asking" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Padding="16,12" MaxWidth="560"
                CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock x:Name="AskingText" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AskingAllow" Content="Allow" Style="{ThemeResource AccentButtonStyle}" Click="OnAskingAnswer" Tag="allow" />
                    <Button x:Name="AskingDeny" Content="Don't allow" Click="OnAskingAnswer" Tag="deny" />
                    <CheckBox x:Name="AskingKeep" Content="Remember for this site" IsChecked="True" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Your accounts for the sign-in box the caret is in, under that box. Placed by MainWindow.Passwords. -->
        <Canvas x:Name="Overlay" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Border x:Name="Logins" Width="300" Padding="4" CornerRadius="8" Visibility="Collapsed"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <ListView x:Name="LoginRows" SelectionMode="None" IsItemClickEnabled="True" MaxHeight="260">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PanelRow">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Canvas>

        <!-- A sign-in that worked, offered for keeping. -->
        <Border x:Name="Keeping" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,20,0" Padding="16,12" MaxWidth="420"
                CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Spacing="10">
                <TextBlock x:Name="KeepingText" TextWrapping="Wrap" />
                <StackPanel x:Name="KeepingButtons" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="KeepingSave" Content="Save" Style="{ThemeResource AccentButtonStyle}" Click="OnKeeping" Tag="save" />
                    <Button Content="Not now" Click="OnKeeping" Tag="later" />
                    <Button Content="Never for this site" Click="OnKeeping" Tag="never" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- A peek at a link: its page over this one, which stays where it was underneath. -->
        <Grid x:Name="Peeking" Grid.Row="1" Grid.Column="1" Visibility="Collapsed">
            <Border x:Name="PeekScrim" Background="#33000000" CornerRadius="8" Margin="4,0,8,8" Tapped="OnPeekScrim" />
            <Border x:Name="PeekCard" Margin="56,24,56,32" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="12,0,4,0" ColumnSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PeekSite" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" />
                        <Button Grid.Column="1" Content="Open as tab" Click="OnPeekKeep" />
                        <Button Grid.Column="2" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" Click="OnPeekClose" />
                    </Grid>
                    <Grid x:Name="PeekStage" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>

        <!-- Ctrl+K: the open tabs by name. -->
        <Border x:Name="Switcher" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0" Width="560" Padding="8"
                CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Spacing="6">
                <TextBox x:Name="SwitcherText" PlaceholderText="Go to a tab" />
                <ListView x:Name="SwitcherRows" SelectionMode="Single" IsItemClickEnabled="True" MaxHeight="420">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PanelRow">
                            <Grid ColumnSpacing="10" Padding="0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>

        <!-- Find on the page. -->
        <Border x:Name="FindBar" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,20,0" Padding="8,4"
                CornerRadius="8" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="FindText" Width="220" PlaceholderText="Find on page" />
                <TextBlock x:Name="FindCount" VerticalAlignment="Center" MinWidth="48" />
                <Button Content="&#xE70E;" FontFamily="Segoe Fluent Icons" Click="OnFindPrevious" />
                <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons" Click="OnFindNext" />
                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="OnFindClose" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
