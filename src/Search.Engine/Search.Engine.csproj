<Project Sdk="Microsoft.NET.Sdk">
  <!-- WebView2, wrapped: environments, profiles, a tab's CoreWebView2, injected scripts, the extensions host. No XAML here.
       CoreWebView2 comes through the Windows App SDK so these are the same WinRT-projected types WinUI's WebView2 control
       hands out; the plain Microsoft.Web.WebView2 package would give the Win32/WPF interop ones, which don't mix. -->
  <PropertyGroup>
    <TargetFramework>$(WindowsTfm)</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>
  <ItemGroup>
    <!-- Scripts that run in pages, kept as .js so they can be read and linted as what they are. -->
    <EmbeddedResource Include="Scripts\**\*.js" LogicalName="Search.Engine.Scripts.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Search.Core\Search.Core.csproj" />
  </ItemGroup>
</Project>
